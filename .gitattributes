# Enforce LF line endings for all text files.
# This prevents Windows CRLF conversion from corrupting the sha256
# checksums of the benchmark JSONL split files.
* text=auto eol=lf

# Explicitly mark binary / data files
*.parquet binary
*.jsonl   text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
